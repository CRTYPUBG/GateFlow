# GateFlow Environment Configuration Example

# Data Plane port for incoming public API traffic
GATEFLOW_PORT=8080

# Control Plane port for administration REST API
GATEFLOW_ADMIN_PORT=8081

# Secret key required for Control Plane CRUD and management
GATEFLOW_ADMIN_KEY=admin-secret-gateflow

# PostgreSQL connection string
DATABASE_URL=postgres://gateflow:gateflow_secret@localhost:5432/gateflow?sslmode=disable
POSTGRES_PASSWORD=gateflow_secret

# Redis connection string for distributed rate limiting & cache
REDIS_URL=redis://localhost:6379/0

# Comma-separated trusted upstream proxies / ingress CIDRs
GATEFLOW_TRUSTED_PROXIES=127.0.0.1,::1

# Whether to accept and parse CF-Connecting-IP from Cloudflare
GATEFLOW_TRUST_CLOUDFLARE=true

# Allow local dev loopback/private target upstreams (disable in production)
GATEFLOW_ALLOW_LOCAL_DEV=true
